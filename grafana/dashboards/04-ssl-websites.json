{
  "uid": "ssl-websites",
  "title": "🔐 SSL Certificates & Websites",
  "tags": ["ssl", "websites", "security"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "row", "title": "SSL Certificate Status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "id": 2, "type": "gauge", "title": "Minimum Days Until Expiry",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0, "max": 365,
          "thresholds": { "mode": "absolute", "steps": [{"color": "red","value": 0}, {"color": "orange","value": 7}, {"color": "yellow","value": 30}, {"color": "green","value": 60}] },
          "color": { "mode": "thresholds" },
          "displayName": "Min Days to Expiry"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "min((ssl_cert_not_after - time()) / 86400)", "legendFormat": "Min Expiry" }]
    },
    {
      "id": 3, "type": "table", "title": "All SSL Certificates",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Days" }, "properties": [
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{"color": "red","value": 0}, {"color": "orange","value": 7}, {"color": "yellow","value": 30}, {"color": "green","value": 60}] } },
            { "id": "unit", "value": "short" }
          ]},
          { "matcher": { "id": "byName", "options": "Expiry Date" }, "properties": [
            { "id": "unit", "value": "dateTimeAsIso" }
          ]}
        ]
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "(ssl_cert_not_after - time()) / 86400", "legendFormat": "", "instant": true, "format": "table" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "ssl_cert_not_after * 1000", "legendFormat": "", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "instance": "Domain", "Value #A": "Days", "Value #B": "Expiry Date" } } },
        { "id": "sortBy", "options": { "fields": [{ "displayName": "Days", "desc": false }] } }
      ],
      "options": { "sortBy": [{ "displayName": "Days", "desc": false }] }
    },
    {
      "id": 10, "type": "row", "title": "Website Uptime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "collapsed": false
    },
    {
      "id": 11, "type": "stat", "title": "Websites UP",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color": "red","value": 0}, {"color": "green","value": 1}] }, "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "count(probe_success{job=\"blackbox-http\"} == 1)", "legendFormat": "UP" }]
    },
    {
      "id": 12, "type": "stat", "title": "Websites DOWN",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color": "green","value": 0}, {"color": "red","value": 1}] }, "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "count(probe_success{job=\"blackbox-http\"} == 0) or vector(0)", "legendFormat": "DOWN" }]
    },
    {
      "id": 13, "type": "stat", "title": "Avg Response Time",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{"color": "green","value": 0}, {"color": "yellow","value": 1}, {"color": "red","value": 3}] }, "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "avg(probe_duration_seconds{job=\"blackbox-http\"})", "legendFormat": "Avg Response" }]
    },
    {
      "id": 14, "type": "stat", "title": "Uptime (30 days)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{"color": "red","value": 0}, {"color": "yellow","value": 95}, {"color": "green","value": 99}] }, "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "avg_over_time(probe_success{job=\"blackbox-http\"}[30d]) * 100", "legendFormat": "Uptime %" }]
    },
    {
      "id": 20, "type": "table", "title": "Website Status & Response Times",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "mappings", "value": [{"options": {"0": {"color": "red","index": 0,"text": "🔴 DOWN"},"1": {"color": "green","index": 1,"text": "🟢 UP"}},"type": "value"}] }
          ]},
          { "matcher": { "id": "byName", "options": "Response Time (s)" }, "properties": [
            { "id": "unit", "value": "s" },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [{"color": "green","value": 0}, {"color": "yellow","value": 1}, {"color": "red","value": 3}] } }
          ]}
        ]
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "probe_success{job=\"blackbox-http\"}", "legendFormat": "", "instant": true, "format": "table" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "probe_duration_seconds{job=\"blackbox-http\"}", "legendFormat": "", "instant": true, "format": "table" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "probe_http_status_code{job=\"blackbox-http\"}", "legendFormat": "", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "instance": "URL", "Value #A": "Status", "Value #B": "Response Time (s)", "Value #C": "HTTP Code" } } },
        { "id": "sortBy", "options": { "fields": [{ "displayName": "Status", "desc": false }] } }
      ]
    },
    {
      "id": 30, "type": "timeseries", "title": "Uptime History",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "bool", "min": 0, "max": 1, "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "probe_success{job=\"blackbox-http\"}", "legendFormat": "{{ instance }}" }]
    }
  ]
}
