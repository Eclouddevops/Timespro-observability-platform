{
  "uid": "aws-ecs",
  "title": "🐳 ECS Services",
  "tags": ["ecs", "aws", "containers"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus" },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(aws_ecs_cpuutilization_average, cluster_name)",
        "label": "ECS Cluster",
        "multi": true,
        "includeAll": true
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(aws_ecs_cpuutilization_average{cluster_name=~\"$cluster\"}, service_name)",
        "label": "Service",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Running Tasks",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color": "red","value": 0}, {"color": "yellow","value": 1}, {"color": "green","value": 2}] }, "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(aws_ecs_running_task_count_average{cluster_name=~\"$cluster\",service_name=~\"$service\"})", "legendFormat": "Running Tasks" }]
    },
    {
      "id": 2, "type": "stat", "title": "Avg CPU %",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{"color": "green","value": 0}, {"color": "yellow","value": 70}, {"color": "red","value": 85}] }, "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(aws_ecs_cpuutilization_average{cluster_name=~\"$cluster\",service_name=~\"$service\"})", "legendFormat": "CPU" }]
    },
    {
      "id": 3, "type": "stat", "title": "Avg Memory %",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{"color": "green","value": 0}, {"color": "yellow","value": 70}, {"color": "red","value": 85}] }, "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg(aws_ecs_memory_utilization_average{cluster_name=~\"$cluster\",service_name=~\"$service\"})", "legendFormat": "Memory" }]
    },
    {
      "id": 4, "type": "stat", "title": "Pending Tasks",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color": "green","value": 0}, {"color": "yellow","value": 1}, {"color": "red","value": 5}] }, "color": { "mode": "thresholds" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(aws_ecs_pending_task_count_average{cluster_name=~\"$cluster\",service_name=~\"$service\"})", "legendFormat": "Pending" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "CPU Utilization per Service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "aws_ecs_cpuutilization_average{cluster_name=~\"$cluster\",service_name=~\"$service\"}", "legendFormat": "{{ cluster_name }} / {{ service_name }}" }]
    },
    {
      "id": 11, "type": "timeseries", "title": "Memory Utilization per Service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "aws_ecs_memory_utilization_average{cluster_name=~\"$cluster\",service_name=~\"$service\"}", "legendFormat": "{{ cluster_name }} / {{ service_name }}" }]
    },
    {
      "id": 12, "type": "timeseries", "title": "Running Task Count",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min", "max"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "aws_ecs_running_task_count_average{cluster_name=~\"$cluster\",service_name=~\"$service\"}", "legendFormat": "{{ cluster_name }} / {{ service_name }}" }]
    }
  ]
}
