{
  "uid": "windows-server-status",
  "title": "🪟 Windows Server Status",
  "description": "Windows EC2 instances — CPU, Memory, Disk, Network, Services, IIS",
  "tags": ["windows", "ec2", "aws", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(windows_os_info, instance)",
        "label": "Windows Instance",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [

    { "id": 1, "type": "row", "title": "📊 Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    {
      "id": 2, "title": "Status",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 }, { "color": "green", "value": 1 }
          ]},
          "mappings": [{ "type": "value", "options": {
            "1": { "text": "🟢 UP",   "color": "green" },
            "0": { "text": "🔴 DOWN", "color": "red"   }
          }}]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "up{job=\"windows-exporter\",instance=~\"$instance\"}", "legendFormat": "{{ instance }}" }]
    },

    {
      "id": 3, "title": "CPU Usage",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (avg by(instance) (rate(windows_cpu_time_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)", "legendFormat": "{{ instance }}" }]
    },

    {
      "id": 4, "title": "Memory Usage",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (windows_os_physical_memory_free_bytes{instance=~\"$instance\"} / windows_cs_physical_memory_bytes{instance=~\"$instance\"} * 100)", "legendFormat": "{{ instance }}" }]
    },

    {
      "id": 5, "title": "C: Drive Usage",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (windows_logical_disk_free_bytes{instance=~\"$instance\",volume=\"C:\"} / windows_logical_disk_size_bytes{instance=~\"$instance\",volume=\"C:\"} * 100)", "legendFormat": "C: {{ instance }}" }]
    },

    {
      "id": 6, "title": "Uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "windows_system_system_up_time{instance=~\"$instance\"}", "legendFormat": "{{ instance }}" }]
    },

    {
      "id": 7, "title": "Running Processes",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "windows_os_processes{instance=~\"$instance\"}", "legendFormat": "{{ instance }}" }]
    },

    { "id": 10, "type": "row", "title": "🔥 CPU", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 }, "collapsed": false },

    {
      "id": 11, "title": "CPU Usage Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (avg by(instance) (rate(windows_cpu_time_total{mode=\"idle\",instance=~\"$instance\"}[5m])) * 100)", "legendFormat": "{{ instance }}" }]
    },

    {
      "id": 12, "title": "CPU Mode Breakdown",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg by(mode) (rate(windows_cpu_time_total{instance=~\"$instance\"}[5m])) * 100", "legendFormat": "{{ mode }}" }
      ]
    },

    { "id": 20, "type": "row", "title": "💾 Memory", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }, "collapsed": false },

    {
      "id": 21, "title": "Memory Usage Over Time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (windows_os_physical_memory_free_bytes{instance=~\"$instance\"} / windows_cs_physical_memory_bytes{instance=~\"$instance\"} * 100)", "legendFormat": "{{ instance }}" }]
    },

    {
      "id": 22, "title": "Memory Detail (Used / Free / Available)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "windows_cs_physical_memory_bytes{instance=~\"$instance\"} - windows_os_physical_memory_free_bytes{instance=~\"$instance\"}", "legendFormat": "Used {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "windows_os_physical_memory_free_bytes{instance=~\"$instance\"}", "legendFormat": "Free {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "windows_os_virtual_memory_free_bytes{instance=~\"$instance\"}", "legendFormat": "Virtual Free {{ instance }}" }
      ]
    },

    { "id": 30, "type": "row", "title": "💿 Disk", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false },

    {
      "id": 31, "title": "Disk Usage per Drive",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "showUnfilled": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (windows_logical_disk_free_bytes{instance=~\"$instance\",volume!~\"HarddiskVolume.*\"} / windows_logical_disk_size_bytes{instance=~\"$instance\",volume!~\"HarddiskVolume.*\"} * 100)", "legendFormat": "{{ instance }} — {{ volume }}" }]
    },

    {
      "id": 32, "title": "Disk I/O (Read / Write bytes/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(windows_logical_disk_read_bytes_total{instance=~\"$instance\",volume!~\"HarddiskVolume.*\"}[5m]))", "legendFormat": "Read {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(windows_logical_disk_write_bytes_total{instance=~\"$instance\",volume!~\"HarddiskVolume.*\"}[5m]))", "legendFormat": "Write {{ instance }}" }
      ]
    },

    { "id": 40, "type": "row", "title": "🌐 Network", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }, "collapsed": false },

    {
      "id": 41, "title": "Network Traffic (In / Out)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(windows_net_bytes_received_total{instance=~\"$instance\",nic!~\".*isatap.*|.*teredo.*\"}[5m]))", "legendFormat": "↓ In {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(windows_net_bytes_sent_total{instance=~\"$instance\",nic!~\".*isatap.*|.*teredo.*\"}[5m]))", "legendFormat": "↑ Out {{ instance }}" }
      ]
    },

    {
      "id": 42, "title": "Network Errors",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(windows_net_packets_received_errors_total{instance=~\"$instance\"}[5m])", "legendFormat": "RX Errors {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "rate(windows_net_packets_outbound_errors_total{instance=~\"$instance\"}[5m])", "legendFormat": "TX Errors {{ instance }}" }
      ]
    },

    { "id": 50, "type": "row", "title": "⚙️ Windows Services", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "collapsed": false },

    {
      "id": 51, "title": "Key Windows Services Status",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "options": { "showHeader": true, "cellHeight": "md" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Running" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [{ "type": "value", "options": {
                "1": { "text": "🟢 Running", "color": "green" },
                "0": { "text": "🔴 Stopped", "color": "red"   }
              }}]}
            ]
          }
        ]
      },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "windows_service_state{instance=~\"$instance\",name=~\"W32Time|WinRM|wuauserv|EventLog|Dnscache|LanmanServer|Schedule|TermService|MSSQLSERVER|W3SVC\",state=\"running\"}",
        "instant": true,
        "format": "table",
        "legendFormat": ""
      }],
      "transformations": [
        { "id": "organize", "options": {
          "renameByName": { "instance": "Instance", "name": "Service", "Value": "Running" },
          "indexByName": { "Instance": 0, "Service": 1, "Running": 2 }
        }}
      ]
    },

    {
      "id": 52, "title": "System Info",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "options": { "showHeader": true, "cellHeight": "md" },
      "fieldConfig": { "defaults": { "custom": { "align": "left" } } },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "windows_os_info{instance=~\"$instance\"}",
        "instant": true,
        "format": "table",
        "legendFormat": ""
      }],
      "transformations": [
        { "id": "organize", "options": {
          "renameByName": { "instance": "Instance", "product": "OS Version", "version": "Build" }
        }}
      ]
    }
  ]
}
