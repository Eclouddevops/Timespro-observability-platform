{
  "uid": "ec2-instance-status",
  "title": "🖥️ EC2 Instance Status",
  "description": "All EC2 instances — Linux & Windows — health at a glance",
  "tags": ["ec2", "aws", "infrastructure", "windows", "linux"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 5,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0
      }
    ]
  },
  "panels": [

    {
      "id": 1, "type": "row",
      "title": "📊 All Instances — Health Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 10,
      "title": "Total Instances",
      "description": "All running EC2 instances being monitored",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "0"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=~\"node-exporter|windows-exporter\"}) or vector(0)",
        "legendFormat": "Total"
      }]
    },

    {
      "id": 11,
      "title": "🟢 Instances UP",
      "description": "Instances responding normally",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "green", "value": 1 }
          ]},
          "noValue": "0"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=~\"node-exporter|windows-exporter\"} == 1) or vector(0)",
        "legendFormat": "UP"
      }]
    },

    {
      "id": 12,
      "title": "🔴 Instances DOWN",
      "description": "Instances not responding — needs attention",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 1 }
          ]},
          "noValue": "0"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=~\"node-exporter|windows-exporter\"} == 0) or vector(0)",
        "legendFormat": "DOWN"
      }]
    },

    {
      "id": 13,
      "title": "🐧 Linux",
      "description": "Linux EC2 instances (Node Exporter)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "noValue": "0"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=\"node-exporter\"}) or vector(0)",
        "legendFormat": "Linux"
      }]
    },

    {
      "id": 14,
      "title": "🪟 Windows",
      "description": "Windows EC2 instances (Windows Exporter)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "0"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=\"windows-exporter\"}) or vector(0)",
        "legendFormat": "Windows"
      }]
    },

    {
      "id": 15,
      "title": "⚠️ High CPU (>80%)",
      "description": "Instances with CPU over 80% — may need scaling",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 1 }
          ]},
          "noValue": "0"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\"}[5m])) * 100) > 80) or vector(0)",
        "legendFormat": "High CPU"
      }]
    },

    {
      "id": 16,
      "title": "📈 Avg CPU",
      "description": "Average CPU across all Linux instances",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "avg(100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\"}[5m])) * 100))",
        "legendFormat": "Avg CPU"
      }]
    },

    {
      "id": 2, "type": "row",
      "title": "🐧 Linux Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },

    {
      "id": 20,
      "title": "🐧 Linux Instance Health",
      "description": "CPU, Memory and Disk for each Linux server. Green = healthy, Yellow = watch, Red = action needed.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 6 },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [{ "displayName": "Server Name", "desc": false }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "filterable": false } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [{ "type": "value", "options": {
                "1": { "text": "🟢  Online",  "color": "green", "index": 0 },
                "0": { "text": "🔴  Offline", "color": "red",   "index": 1 }
              }}]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 90 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory %" },
            "properties": [
              { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 75 },
                { "color": "red", "value": 90 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Disk %" },
            "properties": [
              { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 70 },
                { "color": "red", "value": 85 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Uptime" },
            "properties": [
              { "id": "unit", "value": "dtdurations" },
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Server Name" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          }
        ]
      },
      "targets": [
        {
          "refId": "Status",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "up{job=\"node-exporter\"}",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        },
        {
          "refId": "CPU",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "round(100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\"}[5m])) * 100), 0.1)",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        },
        {
          "refId": "Memory",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "round((1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})) * 100, 0.1)",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        },
        {
          "refId": "Disk",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "round((1 - (node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\",fstype!=\"tmpfs\"})) * 100, 0.1)",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        },
        {
          "refId": "Uptime",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "node_time_seconds{job=\"node-exporter\"} - node_boot_time_seconds{job=\"node-exporter\"}",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "__name__": true, "job": true,
              "account": true, "account_id": true, "az": true,
              "instance_id": true, "instance_type": true,
              "monitored_by": true, "region": true, "env": true,
              "service": true, "os": true, "monitor": true,
              "environment": true, "mountpoint": true,
              "fstype": true, "device": true, "mode": true
            },
            "renameByName": {
              "instance":       "Server Name",
              "Value #Status":  "Status",
              "Value #CPU":     "CPU %",
              "Value #Memory":  "Memory %",
              "Value #Disk":    "Disk %",
              "Value #Uptime":  "Uptime"
            },
            "indexByName": {
              "Server Name": 0,
              "Status":      1,
              "CPU %":       2,
              "Memory %":    3,
              "Disk %":      4,
              "Uptime":      5
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [{ "fieldName": "Server Name", "config": { "id": "isNotNull", "options": {} } }],
            "type": "include",
            "match": "all"
          }
        }
      ]
    },

    {
      "id": 3, "type": "row",
      "title": "🪟 Windows Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "collapsed": false
    },

    {
      "id": 30,
      "title": "🪟 Windows Instance Health",
      "description": "CPU, Memory and Disk for each Windows server. Install Windows Exporter on port 9182 to see live data.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 13 },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [{ "displayName": "Server Name", "desc": false }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [{ "type": "value", "options": {
                "1": { "text": "🟢  Online",  "color": "green", "index": 0 },
                "0": { "text": "🔴  Offline", "color": "red",   "index": 1 }
              }}]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory %" },
            "properties": [
              { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": 0 }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "C: Drive %" },
            "properties": [
              { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Uptime" },
            "properties": [
              { "id": "unit", "value": "dtdurations" }, { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Server Name" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          }
        ]
      },
      "targets": [
        {
          "refId": "Status",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "up{job=\"windows-exporter\"}",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        },
        {
          "refId": "CPU",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "round(100 - (avg by(instance) (rate(windows_cpu_time_total{mode=\"idle\",job=\"windows-exporter\"}[5m])) * 100), 0.1)",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        },
        {
          "refId": "Memory",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "round(100 - (windows_os_physical_memory_free_bytes{job=\"windows-exporter\"} / windows_cs_physical_memory_bytes{job=\"windows-exporter\"} * 100), 0.1)",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        },
        {
          "refId": "Disk",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "round(100 - (windows_logical_disk_free_bytes{job=\"windows-exporter\",volume=\"C:\"} / windows_logical_disk_size_bytes{job=\"windows-exporter\",volume=\"C:\"} * 100), 0.1)",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        },
        {
          "refId": "Uptime",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "windows_system_system_up_time{job=\"windows-exporter\"}",
          "legendFormat": "{{instance}}",
          "instant": true, "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "__name__": true, "job": true,
              "account": true, "account_id": true, "az": true,
              "instance_id": true, "instance_type": true,
              "monitored_by": true, "region": true, "env": true,
              "service": true, "os": true, "volume": true, "mode": true
            },
            "renameByName": {
              "instance":       "Server Name",
              "Value #Status":  "Status",
              "Value #CPU":     "CPU %",
              "Value #Memory":  "Memory %",
              "Value #Disk":    "C: Drive %",
              "Value #Uptime":  "Uptime"
            },
            "indexByName": {
              "Server Name": 0,
              "Status":      1,
              "CPU %":       2,
              "Memory %":    3,
              "C: Drive %":  4,
              "Uptime":      5
            }
          }
        }
      ]
    },

    {
      "id": 4, "type": "row",
      "title": "🔥 CPU Usage Over Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "collapsed": false
    },

    {
      "id": 40,
      "title": "🐧 Linux — CPU % over time",
      "description": "Higher is worse. Above 85% for extended periods means you may need to scale up.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "spanNulls": false },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\",job=\"node-exporter\"}[5m])) * 100)",
        "legendFormat": "🐧 {{ instance }}"
      }]
    },

    {
      "id": 41,
      "title": "🪟 Windows — CPU % over time",
      "description": "Windows server CPU. Requires Windows Exporter installed on port 9182.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "spanNulls": false }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "100 - (avg by(instance) (rate(windows_cpu_time_total{mode=\"idle\",job=\"windows-exporter\"}[5m])) * 100)",
        "legendFormat": "🪟 {{ instance }}"
      }]
    },

    {
      "id": 5, "type": "row",
      "title": "💾 Memory Usage Over Time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "collapsed": false
    },

    {
      "id": 50,
      "title": "🐧 Linux — Memory % over time",
      "description": "How much RAM is in use. Above 90% risks out-of-memory crashes.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})) * 100",
        "legendFormat": "🐧 {{ instance }}"
      }]
    },

    {
      "id": 51,
      "title": "🪟 Windows — Memory % over time",
      "description": "Windows RAM usage over time.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "100 - (windows_os_physical_memory_free_bytes{job=\"windows-exporter\"} / windows_cs_physical_memory_bytes{job=\"windows-exporter\"} * 100)",
        "legendFormat": "🪟 {{ instance }}"
      }]
    },

    {
      "id": 6, "type": "row",
      "title": "💿 Disk Space",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "collapsed": false
    },

    {
      "id": 60,
      "title": "🐧 Linux — Disk Usage (all mount points)",
      "description": "Shows how full each disk partition is. Above 85% needs immediate attention.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true,
        "text": {}
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "(1 - (node_filesystem_avail_bytes{job=\"node-exporter\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs\"} / node_filesystem_size_bytes{job=\"node-exporter\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs\"})) * 100",
        "legendFormat": "🐧 {{ instance }} {{ mountpoint }}"
      }]
    },

    {
      "id": 61,
      "title": "🪟 Windows — Drive Usage (C: D: etc)",
      "description": "How full each Windows drive is. C: drive above 85% needs attention.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 38 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }
          ]}
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "100 - (windows_logical_disk_free_bytes{job=\"windows-exporter\",volume!~\"HarddiskVolume.*\"} / windows_logical_disk_size_bytes{job=\"windows-exporter\",volume!~\"HarddiskVolume.*\"} * 100)",
        "legendFormat": "🪟 {{ instance }} {{ volume }}"
      }]
    },

    {
      "id": 7, "type": "row",
      "title": "🌐 Network Traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "collapsed": false
    },

    {
      "id": 70,
      "title": "🐧 Linux — Network In/Out",
      "description": "Bytes received (↓) and sent (↑) per second. Spikes may indicate attacks or heavy traffic.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(node_network_receive_bytes_total{job=\"node-exporter\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))", "legendFormat": "🐧 ↓ {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(node_network_transmit_bytes_total{job=\"node-exporter\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))", "legendFormat": "🐧 ↑ {{ instance }}" }
      ]
    },

    {
      "id": 71,
      "title": "🪟 Windows — Network In/Out",
      "description": "Windows server network traffic per second.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(windows_net_bytes_received_total{job=\"windows-exporter\",nic!~\".*isatap.*|.*teredo.*\"}[5m]))", "legendFormat": "🪟 ↓ {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(windows_net_bytes_sent_total{job=\"windows-exporter\",nic!~\".*isatap.*|.*teredo.*\"}[5m]))", "legendFormat": "🪟 ↑ {{ instance }}" }
      ]
    },

    {
      "id": 8, "type": "row",
      "title": "⏱️ Uptime & System Load",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 54 },
      "collapsed": false
    },

    {
      "id": 80,
      "title": "⏱️ How Long Each Server Has Been Running",
      "description": "Time since last reboot. Shorter uptimes may indicate recent restarts or crashes.",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 55 },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_time_seconds{job=\"node-exporter\"} - node_boot_time_seconds{job=\"node-exporter\"}", "legendFormat": "🐧 {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "windows_system_system_up_time{job=\"windows-exporter\"}", "legendFormat": "🪟 {{ instance }}" }
      ]
    },

    {
      "id": 81,
      "title": "📊 Linux System Load (1m / 5m / 15m avg)",
      "description": "System load per CPU core. Above 1.0 means the server is overloaded. 0.7 is a healthy warning threshold.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 55 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 1.0 }
          ]}
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_load1{job=\"node-exporter\"}  / on(instance) count by(instance)(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"})", "legendFormat": "🐧 1m  {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_load15{job=\"node-exporter\"} / on(instance) count by(instance)(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"})", "legendFormat": "🐧 15m {{ instance }}" }
      ]
    }
  ]
}
