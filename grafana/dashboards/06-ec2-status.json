{
  "uid": "ec2-instance-status",
  "title": "🖥️ EC2 Instance Status",
  "description": "All EC2 instances — CPU, Network, Health from AWS CloudWatch",
  "tags": ["ec2", "aws", "cloudwatch"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 10,
  "refresh": "1m",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0
      },
      {
        "name": "instance_id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(aws_ec2_cpuutilization_average, instance_id)",
        "label": "Instance",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "refresh": 2
      }
    ]
  },
  "panels": [

    {
      "id": 1, "type": "row",
      "title": "📊 Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 10,
      "title": "Total EC2 Instances",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(aws_ec2_cpuutilization_average) by (instance_id)",
        "legendFormat": "{{ instance_id }}"
      }]
    },

    {
      "id": 11,
      "title": "🟢 Status Healthy",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": 0 },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(aws_ec2_status_check_failed_sum == 0) by (instance_id)",
        "legendFormat": "{{ instance_id }}"
      }]
    },

    {
      "id": 12,
      "title": "🔴 Status Failed",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(aws_ec2_status_check_failed_sum > 0) by (instance_id)",
        "legendFormat": "{{ instance_id }}"
      }]
    },

    {
      "id": 13,
      "title": "Avg CPU %",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": 0  },
            { "color": "yellow", "value": 70 },
            { "color": "red",    "value": 90 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "avg(aws_ec2_cpuutilization_average{instance_id=~\"$instance_id\"})",
        "legendFormat": "Avg CPU"
      }]
    },

    {
      "id": 14,
      "title": "Max CPU %",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": 0  },
            { "color": "yellow", "value": 70 },
            { "color": "red",    "value": 90 }
          ]}
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "max(aws_ec2_cpuutilization_maximum{instance_id=~\"$instance_id\"})",
        "legendFormat": "Max CPU"
      }]
    },

    {
      "id": 15,
      "title": "CloudWatch Exporter",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": 0 },
            { "color": "green", "value": 1 }
          ]},
          "mappings": [{ "type": "value", "options": {
            "1": { "text": "🟢 Connected" },
            "0": { "text": "🔴 Down" }
          }}]
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "up{job=\"cloudwatch\"}",
        "legendFormat": "Status"
      }]
    },

    {
      "id": 2, "type": "row",
      "title": "📋 Instance Health Table",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 20,
      "title": "All EC2 Instances — CPU, Network & Health",
      "description": "Live from AWS CloudWatch. All instances appear automatically.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [{ "displayName": "CPU %", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Health" },
            "properties": [
              { "id": "custom.width", "value": 160 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [{ "type": "value", "options": {
                "0": { "text": "🟢  Healthy",      "color": "green" },
                "1": { "text": "🔴  Check Failed", "color": "red"   }
              }}]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 120 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green",  "value": 0  },
                { "color": "yellow", "value": 70 },
                { "color": "red",    "value": 90 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Network In" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Network Out" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Instance ID" },
            "properties": [{ "id": "custom.width", "value": 210 }]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "targets": [
        {
          "refId": "CPU",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "aws_ec2_cpuutilization_average{instance_id=~\"$instance_id\"}",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "Status",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "aws_ec2_status_check_failed_sum{instance_id=~\"$instance_id\"}",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "NetIn",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "aws_ec2_network_in_sum{instance_id=~\"$instance_id\"}",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "NetOut",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "aws_ec2_network_out_sum{instance_id=~\"$instance_id\"}",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time":       true,
              "job":        true,
              "__name__":   true,
              "instance":   true
            },
            "renameByName": {
              "instance_id":    "Instance ID",
              "Value #CPU":     "CPU %",
              "Value #Status":  "Health",
              "Value #NetIn":   "Network In",
              "Value #NetOut":  "Network Out"
            },
            "indexByName": {
              "Instance ID":  0,
              "Health":       1,
              "CPU %":        2,
              "Network In":   3,
              "Network Out":  4
            }
          }
        }
      ]
    },

    {
      "id": 3, "type": "row",
      "title": "🔥 CPU Usage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },

    {
      "id": 30,
      "title": "CPU % per Instance",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 12 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "aws_ec2_cpuutilization_average{instance_id=~\"$instance_id\"}",
        "legendFormat": "{{ instance_id }}"
      }]
    },

    {
      "id": 31,
      "title": "CPU Current",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": 0  },
            { "color": "yellow", "value": 70 },
            { "color": "red",    "value": 90 }
          ]}
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "aws_ec2_cpuutilization_average{instance_id=~\"$instance_id\"}",
        "legendFormat": "{{ instance_id }}"
      }]
    },

    {
      "id": 4, "type": "row",
      "title": "🌐 Network",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },

    {
      "id": 40,
      "title": "Network In",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "aws_ec2_network_in_sum{instance_id=~\"$instance_id\"}",
        "legendFormat": "↓ {{ instance_id }}"
      }]
    },

    {
      "id": 41,
      "title": "Network Out",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "aws_ec2_network_out_sum{instance_id=~\"$instance_id\"}",
        "legendFormat": "↑ {{ instance_id }}"
      }]
    },

    {
      "id": 5, "type": "row",
      "title": "❤️ Health Checks",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },

    {
      "id": 50,
      "title": "Status Check Failed (0 = Healthy)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0, "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "lineInterpolation": "stepAfter"
          },
          "mappings": [{ "type": "value", "options": {
            "0": { "text": "✅ Healthy", "color": "green" },
            "1": { "text": "❌ Failed",  "color": "red"   }
          }}]
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "aws_ec2_status_check_failed_sum{instance_id=~\"$instance_id\"}",
        "legendFormat": "{{ instance_id }}"
      }]
    }

  ]
}
