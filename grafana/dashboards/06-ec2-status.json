{
  "uid": "ec2-instance-status",
  "title": "🖥️ EC2 Instance Status",
  "description": "All EC2 instances — Linux (Node Exporter) + Windows (Windows Exporter) in one dashboard",
  "tags": ["ec2", "aws", "infrastructure", "windows", "linux"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0
      },
      {
        "name": "linux_instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(node_uname_info, instance)",
        "label": "Linux Instance",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "windows_instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(up{job=\"windows-exporter\"}, instance)",
        "label": "Windows Instance",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [

    {
      "id": 1, "type": "row",
      "title": "📊 All Instances Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },

    {
      "id": 10, "title": "Total EC2 Instances",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" }, "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=~\"node-exporter|ec2-nodes|windows-exporter\"})",
        "legendFormat": "Total"
      }]
    },

    {
      "id": 11, "title": "Instances UP",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }, "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=~\"node-exporter|ec2-nodes|windows-exporter\"} == 1) or vector(0)",
        "legendFormat": "UP"
      }]
    },

    {
      "id": 12, "title": "Instances DOWN",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }, "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=~\"node-exporter|ec2-nodes|windows-exporter\"} == 0) or vector(0)",
        "legendFormat": "DOWN"
      }]
    },

    {
      "id": 13, "title": "Linux Instances",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" }, "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=~\"node-exporter|ec2-nodes\"}) or vector(0)",
        "legendFormat": "Linux"
      }]
    },

    {
      "id": 14, "title": "Windows Instances",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" }, "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(up{job=\"windows-exporter\"}) or vector(0)",
        "legendFormat": "Windows"
      }]
    },

    {
      "id": 15, "title": "High CPU (>80%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 3, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }, "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "count(100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100) > 80) or count(100 - (avg by(instance) (rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100) > 80) or vector(0)",
        "legendFormat": "High CPU"
      }]
    },

    {
      "id": 16, "title": "Avg CPU % (All)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 3, "w": 3, "x": 21, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "avg(100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100))",
        "legendFormat": "Linux Avg"
      }]
    },

    {
      "id": 2, "type": "row",
      "title": "🐧 Linux Instances — observability-server & others",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false
    },

    {
      "id": 20, "title": "Linux — Instance Status",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 5 },
      "options": { "showHeader": true, "cellHeight": "md", "sortBy": [{ "displayName": "Instance", "desc": false }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [
            { "id": "custom.width", "value": 120 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "mappings", "value": [{ "type": "value", "options": {
              "1": { "text": "🟢 UP",   "color": "green" },
              "0": { "text": "🔴 DOWN", "color": "red"   }
            }}]}
          ]},
          { "matcher": { "id": "byName", "options": "CPU %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "Memory %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": 0 }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "Disk %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "Uptime" }, "properties": [{ "id": "unit", "value": "dtdurations" }] }
        ]
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "up{job=~\"node-exporter|ec2-nodes\",instance=~\"$linux_instance\"}", "instant": true, "format": "table", "legendFormat": "" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "round(100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$linux_instance\"}[5m])) * 100), 0.1)", "instant": true, "format": "table", "legendFormat": "" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "round((1 - (node_memory_MemAvailable_bytes{instance=~\"$linux_instance\"} / node_memory_MemTotal_bytes{instance=~\"$linux_instance\"})) * 100, 0.1)", "instant": true, "format": "table", "legendFormat": "" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "round((1 - (node_filesystem_avail_bytes{instance=~\"$linux_instance\",mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{instance=~\"$linux_instance\",mountpoint=\"/\",fstype!=\"tmpfs\"})) * 100, 0.1)", "instant": true, "format": "table", "legendFormat": "" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_time_seconds{instance=~\"$linux_instance\"} - node_boot_time_seconds{instance=~\"$linux_instance\"}", "instant": true, "format": "table", "legendFormat": "" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "renameByName": { "instance": "Instance", "Value #A": "Status", "Value #B": "CPU %", "Value #C": "Memory %", "Value #D": "Disk %", "Value #E": "Uptime" },
          "indexByName": { "Instance": 0, "Status": 1, "CPU %": 2, "Memory %": 3, "Disk %": 4, "Uptime": 5 }
        }}
      ]
    },

    {
      "id": 3, "type": "row",
      "title": "🪟 Windows Instances — windows-server",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "collapsed": false
    },

    {
      "id": 30, "title": "Windows — Instance Status",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 11 },
      "options": { "showHeader": true, "cellHeight": "md", "sortBy": [{ "displayName": "Instance", "desc": false }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [
            { "id": "custom.width", "value": 120 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "mappings", "value": [{ "type": "value", "options": {
              "1": { "text": "🟢 UP",   "color": "green" },
              "0": { "text": "🔴 DOWN", "color": "red"   }
            }}]}
          ]},
          { "matcher": { "id": "byName", "options": "OS" }, "properties": [
            { "id": "custom.width", "value": 100 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "mappings", "value": [{ "type": "value", "options": {
              "windows": { "text": "🪟 Windows", "color": "blue" }
            }}]}
          ]},
          { "matcher": { "id": "byName", "options": "CPU %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "Memory %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": 0 }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "C: Disk %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }
            ]}}
          ]},
          { "matcher": { "id": "byName", "options": "Uptime" }, "properties": [{ "id": "unit", "value": "dtdurations" }] }
        ]
      },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "up{job=\"windows-exporter\",instance=~\"$windows_instance\"}", "instant": true, "format": "table", "legendFormat": "" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "round(100 - (avg by(instance) (rate(windows_cpu_time_total{mode=\"idle\",instance=~\"$windows_instance\"}[5m])) * 100), 0.1)", "instant": true, "format": "table", "legendFormat": "" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "round(100 - (windows_os_physical_memory_free_bytes{instance=~\"$windows_instance\"} / windows_cs_physical_memory_bytes{instance=~\"$windows_instance\"} * 100), 0.1)", "instant": true, "format": "table", "legendFormat": "" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "round(100 - (windows_logical_disk_free_bytes{instance=~\"$windows_instance\",volume=\"C:\"} / windows_logical_disk_size_bytes{instance=~\"$windows_instance\",volume=\"C:\"} * 100), 0.1)", "instant": true, "format": "table", "legendFormat": "" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "windows_system_system_up_time{instance=~\"$windows_instance\"}", "instant": true, "format": "table", "legendFormat": "" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "renameByName": { "instance": "Instance", "os": "OS", "Value #A": "Status", "Value #B": "CPU %", "Value #C": "Memory %", "Value #D": "C: Disk %", "Value #E": "Uptime" },
          "indexByName": { "Instance": 0, "OS": 1, "Status": 2, "CPU %": 3, "Memory %": 4, "C: Disk %": 5, "Uptime": 6 }
        }}
      ]
    },

    {
      "id": 4, "type": "row",
      "title": "🔥 CPU — All Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },

    {
      "id": 40, "title": "CPU Usage — Linux Instances",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$linux_instance\"}[5m])) * 100)", "legendFormat": "🐧 {{ instance }}" }]
    },

    {
      "id": 41, "title": "CPU Usage — windows-server",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (avg by(instance) (rate(windows_cpu_time_total{mode=\"idle\",instance=~\"$windows_instance\"}[5m])) * 100)", "legendFormat": "🪟 {{ instance }}" }]
    },

    {
      "id": 5, "type": "row",
      "title": "💾 Memory — All Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false
    },

    {
      "id": 50, "title": "Memory Usage — Linux Instances",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$linux_instance\"} / node_memory_MemTotal_bytes{instance=~\"$linux_instance\"})) * 100", "legendFormat": "🐧 {{ instance }}" }]
    },

    {
      "id": 51, "title": "Memory Usage — windows-server",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (windows_os_physical_memory_free_bytes{instance=~\"$windows_instance\"} / windows_cs_physical_memory_bytes{instance=~\"$windows_instance\"} * 100)", "legendFormat": "🪟 {{ instance }}" }]
    },

    {
      "id": 6, "type": "row",
      "title": "💿 Disk — All Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false
    },

    {
      "id": 60, "title": "Disk Usage — Linux (mountpoints)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } } },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "showUnfilled": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "(1 - (node_filesystem_avail_bytes{instance=~\"$linux_instance\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{instance=~\"$linux_instance\",fstype!~\"tmpfs|overlay|squashfs\"})) * 100", "legendFormat": "🐧 {{ instance }} — {{ mountpoint }}" }]
    },

    {
      "id": 61, "title": "Disk Usage — windows-server (drives)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } } },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "showUnfilled": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "100 - (windows_logical_disk_free_bytes{instance=~\"$windows_instance\",volume!~\"HarddiskVolume.*\"} / windows_logical_disk_size_bytes{instance=~\"$windows_instance\",volume!~\"HarddiskVolume.*\"} * 100)", "legendFormat": "🪟 {{ instance }} — {{ volume }}" }]
    },

    {
      "id": 7, "type": "row",
      "title": "🌐 Network — All Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "collapsed": false
    },

    {
      "id": 70, "title": "Network Traffic — Linux Instances",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(node_network_receive_bytes_total{instance=~\"$linux_instance\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))", "legendFormat": "🐧 ↓ In {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(node_network_transmit_bytes_total{instance=~\"$linux_instance\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))", "legendFormat": "🐧 ↑ Out {{ instance }}" }
      ]
    },

    {
      "id": 71, "title": "Network Traffic — windows-server",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(windows_net_bytes_received_total{instance=~\"$windows_instance\",nic!~\".*isatap.*|.*teredo.*\"}[5m]))", "legendFormat": "🪟 ↓ In {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by(instance) (rate(windows_net_bytes_sent_total{instance=~\"$windows_instance\",nic!~\".*isatap.*|.*teredo.*\"}[5m]))", "legendFormat": "🪟 ↑ Out {{ instance }}" }
      ]
    },

    {
      "id": 8, "type": "row",
      "title": "⚙️ System — All Instances",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
      "collapsed": false
    },

    {
      "id": 80, "title": "Load Average — Linux Instances",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_load1{instance=~\"$linux_instance\"}",  "legendFormat": "🐧 1m  {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_load5{instance=~\"$linux_instance\"}",  "legendFormat": "🐧 5m  {{ instance }}" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "node_load15{instance=~\"$linux_instance\"}", "legendFormat": "🐧 15m {{ instance }}" }
      ]
