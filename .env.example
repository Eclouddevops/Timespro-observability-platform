# ═══════════════════════════════════════════════════════════════════
# Observability Platform — Environment Variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore — NEVER commit real credentials.
# ═══════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Grafana ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe2024!
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_API_KEY=

# ── AWS Credentials ───────────────────────────────────────────────────
# Recommended: use IAM Instance Profile instead of static credentials.
# Minimum IAM permissions needed:
#   cloudwatch:GetMetricData, cloudwatch:ListMetrics
#   sts:GetCallerIdentity (for multi-account)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# For multi-account: set the role ARN to assume in each account
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/PrometheusCloudWatchRole

# ── AI Providers (at least one required for AI agent) ─────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Notifications ─────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── SMTP (optional, for email alerts) ────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com

# ── PagerDuty (optional) ─────────────────────────────────────────────
# PAGERDUTY_SERVICE_KEY=
