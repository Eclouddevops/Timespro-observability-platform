# ═══════════════════════════════════════════════════════════════════
# Observability Platform — Environment Variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore — NEVER commit real credentials.
# ═══════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Grafana ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe2024!
GRAFANA_ROOT_URL=https://grafana.example.com
GRAFANA_API_KEY=

# ── AWS Region ────────────────────────────────────────────────────────
# NO ACCESS KEY / SECRET KEY NEEDED!
# Attach IAM Role "ObservabilityServerRole" to this EC2 instance.
# Credentials are automatically provided via the instance metadata service.
# See: docs/iam-setup.md for the exact policy and role setup steps.
AWS_DEFAULT_REGION=us-east-1

# For multi-account monitoring — role ARN to assume in each target account
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/ObservabilityReadOnlyRole

# ── AI Providers (at least one required for AI agent) ─────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Notifications — Microsoft Teams ──────────────────────────────────
# Create an Incoming Webhook in MS Teams:
#   Teams channel → ··· → Connectors → Incoming Webhook → Configure
#   Copy the webhook URL and paste below.
MSTEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR-WEBHOOK-URL

# ── SMTP / Email Alerts ───────────────────────────────────────────────
# Alert emails are sent to:
#   Santosh.mirajkar@timesgroup.com
#   samirajkar99@gmail.com
#
# Option 1: Gmail (recommended — easy setup)
#   1. Enable 2FA on your Gmail account
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Generate an App Password for "Mail"
#   4. Use that 16-digit password below (not your Gmail password)
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM=your-gmail@gmail.com
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-digit-app-password

# Option 2: Office 365
# SMTP_HOST=smtp.office365.com:587
# SMTP_FROM=alerts@yourdomain.com
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASSWORD=your-password

# Option 3: AWS SES
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com:587
# SMTP_FROM=alerts@yourdomain.com
# SMTP_USER=YOUR_SES_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_SES_SMTP_PASSWORD

# ── PagerDuty (optional) ─────────────────────────────────────────────
# PAGERDUTY_SERVICE_KEY=

# ── EC2 Auto-Discovery — Multi-Account / Multi-Region ─────────────────
# Primary account uses IAM Instance Profile (no keys needed)
PRIMARY_ACCOUNT_NAME=production

# Comma-separated regions to scan in PRIMARY account
# Use "all" to scan every AWS region
AWS_REGIONS=us-east-1,us-west-2,eu-west-1,ap-southeast-1

# How often to scan (minutes)
DISCOVERY_INTERVAL_MINUTES=2

# Use private IP (true) or public IP (false)
USE_PRIVATE_IP=true

# Optional tag filter — only monitor tagged instances
# Leave TAG_FILTER_KEY blank to monitor ALL running instances
TAG_FILTER_KEY=Monitoring
TAG_FILTER_VALUE=true

# Auto-install Node Exporter via SSH on new EC2s
AUTO_INSTALL_NODE_EXPORTER=false
SSH_KEY_PATH=/path/to/your/ec2-key.pem
SSH_USER=ubuntu

# ── Additional AWS Accounts (cross-account monitoring) ────────────────
# Add all your AWS accounts here as a JSON array.
# Each account needs an IAM role that trusts the observability account.
# See docs/iam-setup.md for the exact trust policy to create.
#
# Format:
# AWS_ACCOUNTS=[
#   {
#     "id":       "111122223333",
#     "name":     "staging",
#     "role_arn": "arn:aws:iam::111122223333:role/ObservabilityReadOnlyRole",
#     "regions":  ["us-east-1","eu-west-1"]
#   },
#   {
#     "id":       "444455556666",
#     "name":     "development",
#     "role_arn": "arn:aws:iam::444455556666:role/ObservabilityReadOnlyRole",
#     "regions":  ["us-east-1"]
#   }
# ]
AWS_ACCOUNTS=[]
